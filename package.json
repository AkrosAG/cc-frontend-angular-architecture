{
  "name": "cc-angular-architecture",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook": "ng run ccAngularArchitecture:storybook",
    "build-storybook": "ng run ccAngularArchitecture:build-storybook",
    "loki:test": "loki test --host host.docker.internal --port 6006",
    "loki:approve": "loki approve --host host.docker.internal --port 6006",
    "lint": "ng lint",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@angular/animations": "^20.1.7",
    "@angular/cdk": "^20.1.6",
    "@angular/common": "^20.1.0",
    "@angular/compiler": "^20.1.0",
    "@angular/core": "^20.1.7",
    "@angular/forms": "^20.1.0",
    "@angular/material": "^20.1.6",
    "@angular/platform-browser": "^20.1.0",
    "@angular/router": "^20.1.0",
    "@canvasjs/angular-stockcharts": "^1.2.0",
    "canvasjs": "^1.8.3",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^20.1.0",
    "@angular/build": "^20.1.5",
    "@angular/cli": "^20.1.5",
    "@angular/compiler-cli": "^20.1.0",
    "@compodoc/compodoc": "^1.1.26",
    "@storybook/angular": "^9.1.1",
    "@types/jasmine": "~5.1.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "jasmine-core": "~5.8.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.3.2",
    "storybook": "^9.1.1",
    "typescript": "~5.8.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "loki": "^0.35.0"
  },
  "storybook": {
    "builder": "@storybook/angular:start-storybook",
    "options": {
      "port": 6006,
      "host": "0.0.0.0"
    }
  },
  "loki": {
    "configurations": {
      "chrome.laptop": {
        "target": "chrome.docker",
        "width": 1366,
        "height": 768,
        "deviceScaleFactor": 1,
        "mobile": false
      },
      "chrome.iphone7": {
        "target": "chrome.docker",
        "preset": "iPhone 7"
      }
    }
  }
}
